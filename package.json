{
  "name": "dsh-a2a-hitl",
  "version": "0.1.0",
  "description": "A reusable DeepSeek Harness plugin for A2A SSE calls and trusted human-input relay",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0",
    "dsh": "^0.2.1-rc.5 || ^0.2.2-rc.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "examples/profile.patch.yml",
    "README.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.verify.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node --import tsx examples/local-demo.ts",
    "prepack": "npm run check",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ipaddr.js": "2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-rc.5 || ^0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.2",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninetyhe-90/dsh-a2a-hitl.git"
  },
  "homepage": "https://github.com/ninetyhe-90/dsh-a2a-hitl#readme",
  "bugs": {
    "url": "https://github.com/ninetyhe-90/dsh-a2a-hitl/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "a2a",
    "hitl",
    "human-in-the-loop",
    "cordis"
  ]
}
